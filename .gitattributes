# Preserve original document/image bytes and avoid treating PDF streams as text.
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.stl binary
*.zip binary

# Preserve imported fixed-format manufacturer tables and original source spacing.
hardware/** -text -whitespace
sources/** -text -whitespace
firmware/FPGA_512/** -text -whitespace

# Preserve KiCad-generated SVG spacing and pinned third-party bundle/license bytes.
# Their exact hashes are recorded in the export and vendor provenance manifests.
presentation/fpga/assets/core-*.svg -text -whitespace
presentation/fpga/assets/current-*.svg -text -whitespace
presentation/fpga/viewer/vendor/** -text -whitespace

# Require deliberate resolution when both branches change the same CAD file.
# Different sheets and board projects can still merge as separate files.
*.kicad_pcb -merge
*.kicad_sch -merge
*.kicad_pro -merge
*.kicad_sym -merge
*.kicad_mod -merge

# Preserve native KiCad SVG exports and pinned runtime bytes in the V16 deck.
presentation/meetings/2026-10-14-v16/**/*.svg -text -whitespace
presentation/meetings/2026-10-14-v16/carrier_viewer/vendor/** -text -whitespace
presentation/meetings/2026-10-14-v16/fpga_viewer/vendor/** -text -whitespace
presentation/meetings/2026-10-14-v16/**/*.kicad_pcb -text -whitespace

# Preserve exact source-native SVG bytes in the current overview.
presentation/overview/assets/*.svg -text -whitespace

# Preserve pinned V23 runtime and the original CC0 notice bytes.
presentation/overview/assembly-v23/vendor/** -text -whitespace
presentation/overview/assembly-v23/licenses/Quaternius_CC0.txt -text -whitespace

# Preserve source-native export spacing and pinned bytes in the 21 October deck.
presentation/meetings/2026-10-21-v2/**/*.svg -text -whitespace
presentation/meetings/2026-10-21-v2/**/*.kicad_pcb -text -whitespace
presentation/meetings/2026-10-21-v2/assembly-v23/vendor/** -text -whitespace
presentation/meetings/2026-10-21-v2/assembly-v23/licenses/Quaternius_CC0.txt -text -whitespace
presentation/meetings/2026-10-21-v2/carrier-viewer-v42/vendor/** -text -whitespace
presentation/meetings/2026-10-21-v2/carrier-viewer-v42/review-files/** -text -whitespace

# Preserve source-native V8 SVG exports and the CSV exporter's CRLF bytes.
xem8310-v8/assets/*.svg -text -whitespace
xem8310-v8/assets/components.csv -text whitespace=cr-at-eol
xem8310-v8/assets/vendor/** -text -whitespace

# Preserve exact V9 native schematic export and component CSV bytes.
xem8310/assets/*.svg -text -whitespace
xem8310/assets/components.csv -text whitespace=cr-at-eol

# Preserve the earlier V9 native exports and pinned V10 runtime/CSV bytes.
xem8310-v9/assets/*.svg -text -whitespace
xem8310-v9/assets/components.csv -text whitespace=cr-at-eol
xem8310/assets/vendor/** -text -whitespace
xem8310/assets/board-features.csv -text whitespace=cr-at-eol

# Preserve exact KiCad export spacing and pinned vendor bytes in the 28 October deck.
# Authored HDMI SVG, slide HTML/CSS/JS and comments UI remain whitespace-checked.
presentation/meetings/2026-10-28-v8/assets/breakout/*.svg -text -whitespace
presentation/meetings/2026-10-28-v8/assets/carrier/*.svg -text -whitespace
presentation/meetings/2026-10-28-v8/assets/system-viewer/vendor/** -text -whitespace
presentation/meetings/2026-10-28-v8/assets/carrier/assembly-viewer/vendor/** -text -whitespace

# Preserve exact KiCad exports, native PCB snapshots and pinned V9 vendor/license bytes.
# Authored slide and viewer code remains whitespace-checked.
presentation/meetings/2026-10-28-v9/assets/breakout/*.svg -text -whitespace
presentation/meetings/2026-10-28-v9/assets/carrier/*.svg -text -whitespace
presentation/meetings/2026-10-28-v9/assets/system-viewer/vendor/** -text -whitespace
