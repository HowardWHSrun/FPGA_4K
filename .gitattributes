# Preserve original document/image bytes and avoid treating PDF streams as text.
*.pdf binary
*.pptx binary
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.stl binary
*.zip binary

# Preserve imported fixed-format manufacturer tables and original source spacing.
hardware/** -text -whitespace
sources/** -text -whitespace
firmware/FPGA_512/** -text -whitespace

# Preserve KiCad-generated SVG spacing and pinned third-party bundle/license bytes.
# Their exact hashes are recorded in the export and vendor provenance manifests.
presentation/fpga/assets/core-*.svg -text -whitespace
presentation/fpga/viewer/vendor/** -text -whitespace

# Require deliberate resolution when both branches change the same CAD file.
# Different sheets and board projects can still merge as separate files.
*.kicad_pcb -merge
*.kicad_sch -merge
*.kicad_pro -merge
*.kicad_sym -merge
*.kicad_mod -merge
