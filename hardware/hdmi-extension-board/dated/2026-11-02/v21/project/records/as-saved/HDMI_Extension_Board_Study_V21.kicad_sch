erty "Source_Symbol" "Codex adaptation of BRK8305 A03 USB graphical pin geometry; original20-pin contract retained" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Source_Footprint" "KiCad10 USB_C_Receptacle_GCT_USB4110; local four SH-to-M1-M4 SMT shell pad names" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Source_changes" "Codex adapts BRK8305 A03 USB symbol for GCT USB4110-GF-A. All16 A/B and4 shell pin identities and existing wiring retained. KiCad10 USB4110 footprint copied locally; four SH SMT pads renamed M1-M4. GCT drawing USB4110 revB4,22May2024,sheet1/2. Same X/Y footprint origin/body-front edge; mating height1.68mm versus priorUSB4105 1.73mm. 3D uses inherited datasheet-derived shell envelope, not manufacturer CAD; no USB4105 PTH legs. Assembly/mechanical/USB qualification pending. V12 Codex footprint adaptation: only the two physical outer DGND lands (four native labels A1/B12/A12/B1) change roundrect ratio0.25 to0.40 (radius0.24mm). Centers,0.6x1.15mm land envelope and diameter0.65mm locating holes retained. Native drill-to-copper clearance0.216088mm; connector-scoped0.20mm JLC minimum. Assembly/CAM acceptance remains open; this is not an unchanged GCT land pattern." (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Assembly_Status" "Reference catalog; imported dnp=no does not preserve Altium assembly variants. Original source excludes MC4 and R75; verify fitted BOM." (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "PARTNUMBER" "002404" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "3D_Model_Status" "Illustrative datasheet-derived USB4110 shell envelope only; inherited V62 source. Manufacturer/stock production model unavailable; verify enclosure and cable clearance." (at 544.83 -95.25 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1.27 1.27)))) (property "Original_Footprint" "USBJTAG_V5:CompactCarrierV1_USB_C_Receptacle_GCT_USB4110_GF_A_Horizontal" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1 1)))) (property "Manufacturer" "Global Connector Technology" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1 1)))) (property "Manufacturer_PN" "USB4110-GF-A" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1 1)))) (property "JLCPCB" "C5143397" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1 1)))) (property "JLC_Audit_Status" "PUBLIC_STOCK_PRESENT_NOT_RESERVED" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1 1)))) (property "JLC_Public_Source" "https://jlcpcb.com/partdetail/5762033-USB4110_GFA/C5143397" (at 622.3 358.14 0) (hide yes) (show_name no) (do_not_autoplace no) (effects (font (size 1 1)))) (pin "B4" (uuid "0d711b28-2f04-4fc8-aa7b-237b1ce244da")) (pin "B1" (uuid "d734ad0e-7372-427a-a140-f4e83cf1ba3b")) (pin "B5" (uuid "7eb3f47d-1182-4146-9e46-cc7155c06cca")) (pin "B6" (uuid "950327de-e48f-424c-8844-d695ef83c5dc")) (pin "A12" (uuid "2b9a74da-f86e-44e1-8a7c-4fd457a37d7d")) (pin "A5" (uuid "2015dca5-e078-464c-99a8-442116a37c0a")) (pin "A4" (uuid "00f80fa7-49a9-4800-a0e9-3e527618c6aa")) (pin "A7" (uuid "5f188eef-86b0-412b-8b18-0730c6a18024")) (pin "A8" (uuid "bd2f9e77-5bd3-4f86-b40a-95282551ff58")) (pin "A6" (uuid "4eca34b2-889f-4864-88e2-27dcfe2d5e85")) (pin "A9" (uuid "ad668e24-bec7-4e99-a5e8-8ba9c404885e")) (pin "A1" (uuid "ab757fc0-3623-4405-af8d-9b57f5452757")) (pin "B12" (uuid "4332f52e-37ee-49a4-b898-b54b5296e071")) (pin "M3" (uuid "2c11320d-6dbf-497e-b8ef-8220885f7755")) (pin "M4" (uuid "e406a221-d4ee-47b0-b321-b82336e255d3")) (pin "M1" (uuid "e9279180-d