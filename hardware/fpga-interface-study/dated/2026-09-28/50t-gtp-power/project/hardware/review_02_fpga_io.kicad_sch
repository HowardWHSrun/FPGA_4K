  (embedded_fonts no)
  (text "02 / FPGA digital I/O - what each signal group does"
    (at 15.24 17.78 0)
    (effects
      (font
        (size 3.8 3.8))
      (justify left))
    (uuid b38d6e8b-6338-5c9e-8c32-25ef4c707e5f))
  (text "Three 1.5 V I/O banks; proposed ball assignments. Pin names connect to the same names on J5, sheet 5."
    (at 15.24 31 0)
    (effects
      (font
        (size 2.7 2.7))
      (justify left))
    (uuid 53659bc7-3e0f-5f1c-92e5-072857867ee0))
  (text "ASIC DATA + RETURNED CLOCKS"
    (at 18 244 0)
    (effects
      (font
        (size 3.7 3.7))
      (justify left))
    (uuid e464fdbb-165e-5567-88a1-978b52e2b0c4))
  (text "Each ASIC sends digital data and a capture clock to U1."
    (at 18 253 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 82cc8dfb-7cc7-5ceb-94a6-b08c92938c31))
  (text "Use that ASIC clock to define its data timing group."
    (at 18 261 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 5aca1d0a-e87d-5775-b365-c2fa6dcdf14a))
  (text "Match delays within the required group after Gerald"
    (at 18 269 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid b1b31c63-0d10-567e-b89f-94f7f05b140b))
  (text "confirms setup/hold timing, including carrier delays."
    (at 18 277 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 23a458df-6172-57ed-b488-79afa8b8abb4))
  (text "COMMANDS SENT BACK TO THE ASICs"
    (at 310 244 0)
    (effects
      (font
        (size 3.7 3.7))
      (justify left))
    (uuid 5085d4e7-2f1f-5def-83da-59c1ba1032ea))
  (text "SPI writes configuration; reset and recording controls"
    (at 310 253 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid c6bcc769-1b58-5d27-99e8-57ac501c8a0f))
  (text "set the operating state. Generated clocks go outward."
    (at 310 261 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 61adc07f-645a-55ca-9a2d-eac7cccdbf17))
  (text "Confirm direction, polarity and startup defaults before"
    (at 310 269 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid c28f5000-1b22-5a9c-b1ee-585d8c9d1307))
  (text "routing. Low-speed controls still need valid timing."
    (at 310 277 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 854fad78-ca1f-5366-8dff-e1a1a033fd2d))
  (text "PROPOSED BANK ALLOCATION"
    (at 18 314 0)
    (effects
      (font
        (size 3.7 3.7))
      (justify left))
    (uuid 6a4ce5a8-2a87-5115-b685-e2e6b09ee55a))
  (text "ASIC 1-3: bank 14. ASIC 4-6: bank 15. ASIC 7-8: bank 34."
    (at 18 323 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 759ed320-7f94-5d3f-8b0d-186504144475))
  (text "All three use the same 1.5 V supply in this draft."
    (at 18 331 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 986dbbc1-39e9-55ff-840d-9f6605b8e196))
  (text "Vivado pin/clock checks and carrier pin-map review remain."
    (at 18 339 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid bb104b16-5198-54fc-a472-9a800c967cde))
  (text "CLOCK SOURCE + UNCONNECTED PINS"
    (at 310 314 0)
    (effects
      (font
        (size 3.7 3.7))
      (justify left))
    (uuid ad92e874-dc74-5abe-8e67-745b98aa3714))
  (text "FABRIC_CLK_1V5_TBD has no oscillator connected."
    (at 310 323 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 793bffee-7e07-5b7d-ade9-1951872ea2ba))
  (text "The old 1.8 V Y1 is held out of the design."
    (at 310 331 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid c0889f1a-8164-5ab9-afc3-5cc3f5f34f8d))
  (text "NC means intentionally unconnected in this proposal;"
    (at 310 339 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 5fbb14ea-52fd-5c6c-b1d9-9d9298afad54))
  (text "it does not mean that a carrier signal can be omitted."
    (at 310 347 0)
    (effects
      (font
        (size 3.2 3.2))
      (justify left))
    (uuid 0b32ada9-5584-5ffa-b648-d5122adb680a)))
