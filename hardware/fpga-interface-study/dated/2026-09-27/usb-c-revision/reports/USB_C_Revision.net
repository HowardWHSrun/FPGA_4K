    <comp ref="U1">
      <value>XC7A100T-1CSG324I</value>
      <footprint>FPGA100T:Xilinx_CSG324</footprint>
      <datasheet>https://docs.amd.com/v/u/en-US/ds181_Artix_7_Data_Sheet</datasheet>
      <fields>
        <field name="MPN">XC7A100T-1CSG324I</field>
        <field name="Function">FPGA</field>
        <field name="Status">Development revision: XC7A100T-1CSG324I selected: standard -1 industrial grade, 1.0 V nominal core; banks 0/14 = 1.8 V, CFGBVS = GND, bank 16 = 2.5 V, banks 15/34/35 = 1.5 V. There are 116 candidate FPGA connections, including provisional digital IMP_TST. AC_IN is a separate 0-1.5 V analog reservation with no FPGA GPIO. Detailed electrical limits, mating and timing remain unverified; MCU link implementation is deferred.</field>
        <field name="Source symbol">FPGA100T:XC7A100T-CSG324</field>
        <field name="Footprint">FPGA100T:Xilinx_CSG324</field>
        <field name="Datasheet">https://docs.amd.com/v/u/en-US/ds181_Artix_7_Data_Sheet</field>
        <field name="Description"/>
      </fields>
      <libsource lib="FPGA100T" part="XC7A100T-CSG324" description="Artix 7 T 100 XC7A100T-CSG324"/>
      <property name="MPN" value="XC7A100T-1CSG324I"/>
      <property name="Function" value="FPGA"/>
      <property name="Status" value="Development revision: XC7A100T-1CSG324I selected: standard -1 industrial grade, 1.0 V nominal core; banks 0/14 = 1.8 V, CFGBVS = GND, bank 16 = 2.5 V, banks 15/34/35 = 1.5 V. There are 116 candidate FPGA connections, including provisional digital IMP_TST. AC_IN is a separate 0-1.5 V analog reservation with no FPGA GPIO. Detailed electrical limits, mating and timing remain unverified; MCU link implementation is deferred."/>
